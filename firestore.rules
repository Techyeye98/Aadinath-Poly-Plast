rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // everyone can read the rates; only the admin account can change them
    match /app/rates {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "ADMIN_EMAIL_HERE";
    }
    match /{document=**} { allow read, write: if false; }
  }
}
